# ==========================================
# Server Configuration
# ==========================================
# Network interface to bind the server to (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0
# Port on which the Strapi server will listen
PORT=1337
# Publicly accessible URL for your Strapi app (used for media links, redirects, webhooks)
PUBLIC_URL=http://localhost:1337
# Strapi backend URL (typically identical to PUBLIC_URL)
STRAPI_URL=http://localhost:1337

# ==========================================
# Security & Secrets
# ==========================================
# Tip: Generate random strings using `openssl rand -base64 16` or `openssl rand -base64 32`

# Comma-separated list of secret keys used to sign session cookies
APP_KEYS=tobemodified_key1,tobemodified_key2,tobemodified_key3,tobemodified_key4
# Salt used for hashing Strapi API tokens
API_TOKEN_SALT=tobemodified_api_token_salt
# Secret used for Admin Panel JWT authentication
ADMIN_JWT_SECRET=tobemodified_admin_jwt_secret
# Secret used for Users & Permissions plugin JWT authentication
JWT_SECRET=tobemodified_jwt_secret
# Salt used for data transfer tokens (Strapi transfer / export / import)
TRANSFER_TOKEN_SALT=tobemodified_transfer_token_salt
# Key used for encrypting stored credentials / configurations
ENCRYPTION_KEY=tobemodified_encryption_key

# ==========================================
# Database Configuration
# ==========================================
# Database client to use: postgres | mysql | sqlite
DATABASE_CLIENT=postgres
# Database host / IP address (e.g. 127.0.0.1, localhost, or remote database host)
DATABASE_HOST=127.0.0.1
# Database port (PostgreSQL default: 5432, MySQL default: 3306)
DATABASE_PORT=5432
# Name of the database
DATABASE_NAME=strapi_db
# Database user
DATABASE_USERNAME=strapi_user
# Database password
DATABASE_PASSWORD=your_secure_password
# Enable or disable SSL connection (true / false)
DATABASE_SSL=false
# Path to SQLite file (only required if DATABASE_CLIENT=sqlite, otherwise leave empty)
DATABASE_FILENAME=

# ==========================================
# Logging (Pino Logger)
# ==========================================
# Log output level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Pretty print logs in console (recommended true for dev, false for production)
LOG_PRETTY=true

# ==========================================
# Observability: OpenTelemetry & SigNoz
# ==========================================
# Master toggle to enable/disable OpenTelemetry (true | false)
OTEL_ENABLED=true
# Name of the service shown in SigNoz UI
OTEL_SERVICE_NAME=ofs-cms
# Deployment environment label in SigNoz
DEPLOYMENT_ENV=development

# --- Option A: SigNoz Cloud ---
# Endpoint format: https://ingest.<region>.signoz.cloud:443 (e.g. us, in, eu)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
# SIGNOZ_INGESTION_KEY=your-signoz-cloud-ingestion-token

# --- Option B: Self-Hosted SigNoz (Local Docker or VM) ---
# Default OTLP HTTP receiver (port 4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SIGNOZ_INGESTION_KEY=

# (Optional) Log flush batch delay in milliseconds (default: 1000)
OTEL_LOG_DELAY_MS=1000
# (Optional) Metric export interval in milliseconds (default: 60000)
OTEL_METRIC_INTERVAL_MS=60000
# (Optional) Diagnostic log level for OpenTelemetry internal troubleshooting: error | warn | info | debug
OTEL_DIAG_LOG_LEVEL=
