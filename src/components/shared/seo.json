{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "seo",
    "icon": "thumbUp"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 70,
      "required": true
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 165,
      "required": true
    },
    "keywords": {
      "type": "string"
    },
    "shareImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "preventIndexing": {
      "type": "boolean",
      "default": false
    },
    "canonicalUrl": {
      "type": "string",
      "regex": "^(https?:\\/\\/)([\\w-]+\\.)+[\\w-]+(\\/[\\w\\-._~:/?#\\[\\]@!$&'()*+,;=%]*)?$"
    }
  },
  "config": {}
}
