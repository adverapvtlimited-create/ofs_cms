{
  "collectionName": "components_shared_social_links",
  "info": {
    "displayName": "social-link",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "platform": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "LinkedIn",
        "Twitter",
        "Facebook",
        "YouTube"
      ]
    },
    "url": {
      "type": "string",
      "required": true,
      "regex": "^(https?:\\/\\/)([\\w-]+\\.)+[\\w-]+(\\/[\\w\\-._~:/?#\\[\\]@!$&'()*+,;=%]*)?$"
    }
  },
  "config": {}
}
