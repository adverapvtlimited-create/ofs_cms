{
  "collectionName": "components_shared_cta_buttons",
  "info": {
    "displayName": "cta-button",
    "icon": "bulletList"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "maxLength": 50,
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "regex": "^\\/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"
    },
    "variant": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "primary",
        "secondary",
        "outline"
      ]
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    },
    "backgroundMedia": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  },
  "config": {}
}
