{
  "kind": "collectionType",
  "collectionName": "enquiries",
  "info": {
    "singularName": "enquiry",
    "pluralName": "enquiries",
    "displayName": "Enquiry",
    "description": "Customer contact form and RFQ submissions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "formType": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "company": {
      "type": "string"
    },
    "subjectOrRole": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "attachedFile": {
      "type": "string"
    },
    "requestStatus": {
      "type": "enumeration",
      "enum": [
        "New",
        "In Progress",
        "Contacted",
        "Resolved",
        "Archived"
      ],
      "default": "New"
    },
    "sourceUrl": {
      "type": "string"
    }
  }
}
