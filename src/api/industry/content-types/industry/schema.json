{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industry",
    "description": "Target industry sectors and sub-industry verticals"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "industryId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "shortName": {
      "type": "string",
      "required": true
    },
    "icon": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "relatedService": {
      "type": "component",
      "repeatable": false,
      "component": "industries.related-service"
    },
    "tagline": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "keySolutions": {
      "type": "json"
    },
    "subIndustries": {
      "type": "component",
      "repeatable": true,
      "component": "industries.sub-industry"
    },
    "fullContentText": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
