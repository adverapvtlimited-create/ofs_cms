{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Industrial products, machinery, spares, and equipment catalogs"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "productId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "shortName": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "keyPoints": {
      "type": "json"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "catalogItems": {
      "type": "component",
      "repeatable": true,
      "component": "products.catalog-item"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
