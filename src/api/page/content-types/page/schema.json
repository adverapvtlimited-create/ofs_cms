{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "isHomePage": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "pageBuilder": {
      "type": "dynamiczone",
      "components": [
        "sections.value-card",
        "sections.sub-service",
        "sections.process-step",
        "sections.hero-banner",
        "sections.feature-grid",
        "sections.catalog-item"
      ],
      "required": true
    }
  }
}
