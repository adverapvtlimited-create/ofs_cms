{
  "kind": "collectionType",
  "collectionName": "careers",
  "info": {
    "singularName": "career",
    "pluralName": "careers",
    "displayName": "career"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "jobTitle": {
      "type": "string",
      "maxLength": 120,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "jobTitle",
      "required": true
    },
    "department": {
      "type": "string",
      "maxLength": 80,
      "required": true
    },
    "location": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "experienceRequired": {
      "type": "string",
      "maxLength": 50
    },
    "employmentType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Full-Time",
        "Part-Time",
        "Contract"
      ]
    },
    "datePosted": {
      "type": "date",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "responsibilities": {
      "type": "component",
      "component": "elements.bullet-item",
      "repeatable": true
    },
    "requirements": {
      "type": "component",
      "component": "elements.bullet-item",
      "repeatable": true
    },
    "benefits": {
      "type": "component",
      "component": "elements.bullet-item",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "enquiries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enquiry.enquiry",
      "mappedBy": "relatedCareer"
    },
    "description": {
      "type": "blocks",
      "required": true
    }
  }
}
