{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "offeringType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Service",
        "Solution",
        "Expertise",
        "Discipline"
      ]
    },
    "shortTitle": {
      "type": "string",
      "maxLength": 60,
      "required": false
    },
    "badge": {
      "type": "string",
      "maxLength": 40
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "icon": {
      "type": "string",
      "maxLength": 50
    },
    "tagline": {
      "type": "string",
      "maxLength": 150,
      "required": true
    },
    "features": {
      "type": "component",
      "component": "elements.bullet-item",
      "repeatable": true
    },
    "subServices": {
      "type": "component",
      "component": "sections.sub-service",
      "repeatable": true
    },
    "process": {
      "type": "component",
      "component": "sections.process-step",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "relatedIndustries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::industry.industry",
      "inversedBy": "services"
    },
    "enquiries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enquiry.enquiry",
      "mappedBy": "relatedService"
    },
    "overview": {
      "type": "blocks",
      "required": true
    }
  }
}
