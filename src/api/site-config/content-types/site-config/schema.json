      "required": true
    },
    "shortName": {
      "type": "string",
      "required": true
    },
    "legalName": {
      "type": "string"
    },
    "usEntityName": {
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "required": true
    },
    "shortDesc": {
      "type": "text",
      "required": true
    },
    "headline": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "longDesc": {
      "type": "text",
      "required": true
    },
    "logo": {
      "type": "string"
    },
    "logoDark": {
      "type": "string"
    },
    "contact": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contact",
      "required": true
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "socials": {
      "type": "component",
      "repeatable": false,
      "component": "shared.socials"
    },
    "certifications": {
