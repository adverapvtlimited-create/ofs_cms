      "unique": true
    },
    "href": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "categoryLabel": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "blocks": {
      "type": "component",
      "repeatable": true,
      "component": "offers.content-block"
    }
  }
}
